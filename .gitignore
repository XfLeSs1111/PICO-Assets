# 项目特有：PICO 驱动运行时日志（每个约 20MB，按天滚动，含无序号的最新日志）
ps_driver_sdk*.log

# 测试输出
TestResults/

# Python 分析脚本缓存
__pycache__/

# 本地构建产物（APK 安装包体积过大，不入库）
apk/

# 本地工具运行数据与索引缓存
.workbuddy/
.guid_index.json

# 仓库根目录临时探测/分析产物
_flows_full.json
_mcp_calls.json
_mcp_probe.py
_probe_err.txt
_probe_flow_details.json
_probe_flow_query*.json
_probe_flow_resources*.json
