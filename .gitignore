_probe_out.txt
_res.txt
_scan2.py
_scan2_log.txt
_scan_flows.py

# Unity 自动截图（每次运行都会新增，不入库）
Assets/Screenshots/

# 编译产物（分析用，可随时重新生成）
Docs/Analysis/**/compile-current/*.dll
Docs/Analysis/**/compile-current/*.pdb

# 编辑器/测试产生的临时备份
*.bak
Assets/Experiments/*/Scenes/TestRecovery_*.unity
Assets/Experiments/*/Scenes/TestRecovery_*.unity.meta
*.bak.meta
